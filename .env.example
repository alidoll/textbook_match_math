# 复制为 .env 并填写（勿提交 .env）

# 默认使用本地 SQLite（data/textbook_match.db），无需安装 / 连接 MySQL。
# 启动时自动建表（db.create_all）。data/ 目录不存在会自动创建。
# 如需改用 MySQL：取消注释下面 USE_MYSQL=1 并填 MYSQL_*，表结构需自行导入。
# USE_MYSQL=1
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的密码
# MYSQL_DATABASE=textbook_match

# 全局基准库（相对仓库根；默认 data/base_data/）
BENCHMARK_OLD_XLSX=data/base_data/全版本旧课标全册次目录清单.xlsx
BENCHMARK_NEW_XLSX=data/base_data/全版本新课标已更新册次目录清单.xlsx
# SELECTION_RESOURCE_XLSX=data/base_data/小学科学同步学资源数据.xlsx

# 选题题面拉取：manual=仅缓存/人工粘贴；http=请求 SELECTION_QUESTION_FETCH_URL
SELECTION_QUESTION_FETCH_PROVIDER=manual
# SELECTION_QUESTION_FETCH_URL=https://example.local/question/{id}

# 旧教材 PDF 磁盘镜像目录（相对仓库根）
OLD_TEXTBOOK_DIR=data/old-textbook
LESSON_PAGES_DIR=data/lesson-pages

FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=dev-change-me

# 分发模式（发给别人「仅新旧教材对比」时取消注释）：
#   test_diff = 首页只保留教材对比；不注册旧库/新库；学科锁定 Test
# DISTRIBUTION_MODE=test_diff

# 产品壳（与 DISTRIBUTION_MODE 独立；试验新链路时用 pipeline）：
#   classic  = 现网四卡：旧库 / 新库 / 对比结果 / 教材对比（默认，随时恢复）
#   pipeline = 教材比对 / 课件制作 / 选题制作 / 小科完整工作台
# PRODUCT_SHELL=pipeline

# 整册教材 PDF 上传上限（MB）；扫描彩印常超过默认 512
MAX_UPLOAD_MB=2048

# 公司 ai-service（compare / AI 预建 / 视觉目录；需公司网或 VPN）
#
# 鉴权二选一（与平台 curl 一致）：
#   A) api-key 头：LLM_AUTH_STYLE=api-key + TAL_MLOPS_APP_ID + TAL_MLOPS_APP_KEY
#   B) Bearer：LLM_APP_ID + LLM_API_KEY（或 LLM_API_KEY=AppID:Key 一整串）
LLM_ENABLED=1
TAL_MLOPS_APP_ID=
TAL_MLOPS_APP_KEY=
# LLM_APP_ID=
# LLM_API_KEY=

# 文本任务：区块 AI 预建、compare 建议等
LLM_MODEL=glm-5.2

# 多模态视觉：目录识别、教材原子整理 Agent（需支持 image_url）
# 豆包多模态示例：
LLM_VISION_MODEL=doubao-seed-2.0-pro
# LLM_ATOM_CURATE_MODEL=doubao-seed-2.0-pro

# ① OCR 本课：两阶段（先文字 normalize，再 OpenCV+Doubao 补插图；1=默认）
ATOM_OCR_TWO_PHASE=1
ATOM_OCR_REMOVE_STAMP=1
ATOM_LAYOUT_LLM=1

# ② AI 整理本页：规则强度（minimal=大模型为主，默认；full=湘科版规则补并/撤销）
ATOM_CURATE_HEURISTICS=minimal

# 新库对照旧块建块：豆包视觉分配新原子→旧块（1=默认；失败时回退规则）
NEW_BLOCK_MIRROR_LLM=1
# NEW_BLOCK_MIRROR_LLM_MODEL=doubao-seed-2.0-pro
# NEW_BLOCK_MIRROR_LLM_TIMEOUT=90

# 双轨实验 ① 教材轨：复用豆包 mirror 按页分配（1=默认；0=仅规则）
DUAL_TRACK_LLM=1
# 双轨前置1：旧课件 slide 豆包文字 OCR（1=默认；0=跳过）
DUAL_TRACK_SLIDE_OCR=1
# 双轨前置1 新教材文字原子：doubao（默认）| rapidocr（回退 annotate 同款）
DUAL_TRACK_TEXTBOOK_TEXT_OCR=doubao

LLM_BASE_URL=http://ai-service.tal.com/openai-compatible/v1
LLM_TEMPERATURE=0.2
# 通用 LLM 超时（秒）；原子整理默认同此值，可单独加大
LLM_TIMEOUT=120
# LLM_ATOM_CURATE_TIMEOUT=180

# 豆包等模型的 reasoning（与 curl 中 reasoning 块一致；不用则留空）
LLM_AUTH_STYLE=api-key
LLM_REASONING_MODE=enabled
LLM_REASONING_EFFORT=low
# LLM_STREAM_INCLUDE_USAGE=1

# 教材库语义建块（科学除外；1=默认启用）
LIB_SEMANTIC_BLOCK=1
LIB_SEMANTIC_CROSS_PAGE=1
LIB_FIGURE_PART_ROLE_LLM=1
LIB_TABLE_GRID_LLM=1
# 整课/整册：同课多页 OCR 并行（1=串行；建议 2～3，过大易触发限流）
LIB_PAGE_OCR_WORKERS=3
# 语义建块：页级 suggest 并行
LIB_SEMANTIC_BLOCK_WORKERS=3
# B：文字主 OCR 后，公式/拼音校对与图片 OCR 并行
LIB_OCR_AUDIT_IMAGE_PARALLEL=1
# D：整册本课建块时预跑下一课 OCR
LIB_VOLUME_OCR_PIPELINE_BLOCKS=1
LIB_SEMANTIC_BLOCK_FALLBACK=error
# 数学公式二次校对（5≠s、n+20 勿漏 0）；0 关闭
PAGE_TEXT_MATH_AUDIT=1
# LLM_SEMANTIC_BLOCK_MODEL=  # 可选，默认跟 vision/chat

# 粗分：batch=整册目录一次 LLM 对照（推荐）；hybrid=逐课15候选；rules=纯规则
LLM_COURSE_MATCH_MODE=batch
LLM_COURSE_MATCH_ENABLED=1
LLM_COURSE_MATCH_MODEL=glm-5.2
LLM_COURSE_MATCH_BATCH_TIMEOUT=120
LLM_COURSE_MATCH_TIMEOUT=45
LLM_COURSE_MATCH_WORKERS=4
